{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Campaign activity, indexer throughput and financial oversight for Trivela.",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Campaign Requests / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum(rate(trivela_route_hits_total{job=\"trivela-backend\",route=~\".*campaigns.*\"}[5m]))",
          "legendFormat": "campaign routes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Claim Requests / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum(rate(trivela_route_hits_total{job=\"trivela-backend\",route=~\".*claim.*\"}[5m]))",
          "legendFormat": "claim routes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total Claims (route hits, 24h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "sum(increase(trivela_route_hits_total{job=\"trivela-backend\",route=~\".*claim.*\"}[24h]))",
          "legendFormat": "claims",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Indexer Events / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 9,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum(rate(indexer_events_total{job=\"trivela-backend\"}[5m]))",
          "legendFormat": "events",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Indexer Lag (ledgers)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 15,
        "y": 8,
        "w": 9,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "max(indexer_lag_ledgers{job=\"trivela-backend\"})",
          "legendFormat": "lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Solvency Ratio",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "targets": [
        {
          "expr": "min(trivela_solvency_ratio{job=\"trivela-backend\"})",
          "legendFormat": "solvency",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Request Errors / s (4xx+5xx)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "expr": "sum(rate(trivela_request_errors_total{job=\"trivela-backend\"}[5m]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["trivela", "campaigns", "finance"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Datasource",
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Trivela Campaigns & Finance",
  "uid": "trivela-campaigns",
  "version": 1
}
