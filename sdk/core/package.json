{
  "name": "@trivela/core",
  "version": "0.1.0",
  "description": "Lightweight vanilla JS/TS SDK for Trivela — zero UI framework dependencies",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts"
  },
  "sideEffects": false,
  "scripts": {
    "check": "tsc --noEmit"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "trivela",
    "stellar",
    "soroban",
    "sdk",
    "vanilla"
  ],
  "license": "Apache-2.0"
}
